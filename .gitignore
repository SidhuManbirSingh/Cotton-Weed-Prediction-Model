# Python & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Model exports & large runtime media
*.onnx
best_openvino_model/
*.mp4
*.avi
*.mov
*.mkv

# Structured raw datasets (keep empty folder placeholders tracked via .gitkeep)
datasets/*/*/*
!datasets/*/*/.gitkeep
datasets/test/labels.cache

# User drop folders (keep put_images_here & put_mp4_videos_here placeholders tracked)
media/put_images_here/*
!media/put_images_here/.gitkeep
media/put_mp4_videos_here/*
!media/put_mp4_videos_here/.gitkeep

# Bulk generated training test predictions (keep results/ curves tracked; ignore 1,850 bulk JPGs)
training/predictions/*
!training/predictions/.gitkeep

# Backend runtime uploads & outputs (keep folder structure tracked via .gitkeep)
backend/data/*/*
!backend/data/*/.gitkeep

# Frontend build artifacts & dependencies
frontend/node_modules/
frontend/dist/

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
